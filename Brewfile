# Terminal & Shell
brew "stow"       # Symlink manager for dotfiles
brew "tmux"       # Terminal multiplexer
brew "starship"   # Cross-shell prompt
brew "bash"       # Updated bash

# Editor
brew "neovim"

# Modern CLI replacements
brew "eza"        # ls replacement
brew "fd"         # find replacement
brew "ripgrep"    # grep replacement

# Git
brew "gh"         # GitHub CLI
brew "git-lfs"    # Git Large File Storage
brew "lazygit"    # Terminal UI for git

# Languages & Version Managers
brew "ruby"
brew "jenv"       # Java version manager
brew "openjdk"

# Dev Tools
brew "watchman"   # File watcher (React Native)
brew "nginx"
brew "yarn"
brew "ni"         # Node package manager detector
brew "ios-deploy" # iOS device deployment

# Databases
brew "postgresql@18"
brew "libpq"      # PostgreSQL client library

# Casks
cask "ghostty"    # Terminal emulator
cask "rectangle"  # Window manager
